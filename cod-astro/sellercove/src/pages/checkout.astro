---
// ── CUSTOMIZE HERE ────────────────────────────────────────────────────────────
// Basket checkout. Reached from the cart drawer; a shopper who never opens the
// cart never comes here and keeps the one-step product form untouched. The
// page is the store's composition of the checkout surface; its required
// section renders the basket and the order form (`CheckoutMain.astro`).
// ─────────────────────────────────────────────────────────────────────────────
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import Sections from "@/theme/components/surface/Sections.astro";
import { checkoutCatalog } from "@/theme/catalog/families/checkout";
import { actions } from "astro:actions";
import { orderOutcome } from "@/theme/pages/order-outcome";

// Store context comes from middleware (Astro.locals.store — Theme Zero S2).
const { config, content, client } = Astro.locals.store;

// A merchant with the cart switched off has no basket to check out.
if (!config.cartEnabled) return Astro.redirect(Astro.locals.store.href("/"), 302);

// Same single PRG redirect the product form uses: the browser follows the 303
// straight to the thank-you page, so this page never re-renders behind it and
// the abandonment-conversion signal fires there.
const outcome = orderOutcome(Astro.getActionResult(actions.placeOrder), content, Astro.locals.store.locale);
if (outcome.redirect) return Astro.redirect(Astro.locals.store.href(outcome.redirect), 303);

const saved = await client.pageData.get("checkout");
---

{/* noindex: transactional and basket-dependent. There is nothing here to
    index, and a crawler would only ever see the empty state — same reasoning
    as the thank-you page. */}
<StoreLayout
  title={`${content.checkoutTitle} — ${config.name}`}
  hideMobileNav={true}
  noindex={true}
  softNavigation={false}
>
  <Sections theme={checkoutCatalog} surface="checkout" document={saved} params={{ surface: "checkout" }} />
</StoreLayout>
