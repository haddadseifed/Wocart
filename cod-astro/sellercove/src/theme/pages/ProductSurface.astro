---
// ── The product surface ─────────────────────────────────────────────────────
// One template renders every product: the store's saved product document, a
// draft in a preview, or the theme's shipped default (`resolveSurfaceDocument`).
// The route reads the product first — an unknown handle is a 404 before
// anything streams — and primes the page's read cache with it, so every
// section and block takes the same product without reading it again. A
// preview of a store with no product yet renders the template empty, so the
// editor can still show and arrange its sections.
import { createReadCache } from "@wocart/theme/astro";
import { productMeta, type Product } from "@wocart/storefront";
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import Sections from "@/theme/components/surface/Sections.astro";
import { productCatalog } from "@/theme/catalog/families/product";
import { productRead } from "@/theme/catalog/product/shared";
import { message } from "@/theme/content/messages";

interface Props {
  product: Product | null;
  /** The document to render: what the store saved (`null` when absent), or a preview's draft. */
  document: unknown;
  preview?: boolean;
  softNavigation?: boolean;
}

const { product, document, preview = false, softNavigation = true } = Astro.props;
const { config, content, locale } = Astro.locals.store;
const reads = createReadCache();
if (product) reads.get(productRead(product.handle), async () => product);
// What search engines and shared links read: what the merchant wrote for them, else the product's name and description.
const meta = product ? productMeta(product) : null;
---

<StoreLayout
  title={meta ? message(content, "productPageTitle", { product: meta.title, storeName: config.name }, locale) : config.name}
  description={meta?.description ?? undefined}
  ogImage={product?.images[0]?.url}
  hideMobileNav={true}
  softNavigation={softNavigation}
  whatsapp={product ? { kind: "product", product: product.name } : undefined}
>
  <Sections theme={productCatalog} surface="product" document={document} preview={preview} params={{ handle: product?.handle, preview: preview ? "true" : undefined }} reads={reads} />
  <slot />
</StoreLayout>

<script src="../scripts/product.ts"></script>
<script src="../scripts/sticky-cta.ts"></script>
<script src="../scripts/track-abandonment.ts"></script>
