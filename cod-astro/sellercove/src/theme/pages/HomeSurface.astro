---
// ── The home surface ────────────────────────────────────────────────────────
// What the home page renders, and an editor's preview of it renders the same
// way: section order comes from a page document — the store's saved one, a
// draft in a preview, or the theme's shipped default when neither can be read
// (`resolveSurfaceDocument`). The store's document is written by the CodFlow
// Cloud control plane (Studio), never by this runtime. A preview marks each
// section for the editor; anything in the default slot (the preview's bridge)
// renders after the sections.
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import Sections from "@/theme/components/surface/Sections.astro";
import { homeCatalog } from "@/theme/catalog/families/home";

interface Props {
  /** The document to render: what the store saved (`null` when absent), or a preview's draft. */
  document: unknown;
  preview?: boolean;
}

const { document, preview = false } = Astro.props;
---

<StoreLayout>
  <Sections theme={homeCatalog} surface="home" document={document} preview={preview} />
  <slot />
</StoreLayout>
