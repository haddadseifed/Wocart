---
// A social network's mark, drawn in the text colour. Brand marks are not in
// the heroicons set, so the four networks a footer offers are drawn here.
import type { SOCIAL_NETWORKS } from "@/theme/catalog/footer/footer.def";

interface Props {
  network: (typeof SOCIAL_NETWORKS)[number];
}

const PATHS: Record<Props["network"], string> = {
  instagram: "M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm5 5.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2ZM17.5 6.5h.01",
  facebook: "M14 22v-9h3l.5-3.5H14V7.3c0-1 .3-1.8 1.8-1.8h1.9V2.4c-.3 0-1.5-.1-2.8-.1-2.8 0-4.7 1.7-4.7 4.8v2.4H7V13h3.2v9H14Z",
  tiktok: "M14 3v9.6a4.4 4.4 0 1 1-3.5-4.3V11a1.8 1.8 0 1 0 1.4 1.7V3h2.1a5 5 0 0 0 5 4.5V10A7 7 0 0 1 14 8.2",
  youtube: "M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 4.8 12 4.8 12 4.8s-6 0-7.7.5A2.7 2.7 0 0 0 2.4 7.2 28 28 0 0 0 2 12a28 28 0 0 0 .4 4.8 2.7 2.7 0 0 0 1.9 1.9c1.7.5 7.7.5 7.7.5s6 0 7.7-.5a2.7 2.7 0 0 0 1.9-1.9A28 28 0 0 0 22 12a28 28 0 0 0-.4-4.8ZM10 15.2V8.8l5.2 3.2-5.2 3.2Z",
};
const filled = Astro.props.network === "facebook" || Astro.props.network === "youtube";
---

<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill={filled ? "currentColor" : "none"} stroke={filled ? "none" : "currentColor"} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  <path d={PATHS[Astro.props.network]} />
</svg>
