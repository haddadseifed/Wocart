---
// The store's header. On a phone: the menu at the start, the logo, search and
// the cart at the end; the menu opens as a drawer from the start side. On a
// wide screen the menu runs beside the logo, or around it when the logo is
// centered. Nothing here is the theme's own words but the controls' names.
import { Image } from "astro:assets";
import type { InferProps } from "@wocart/theme";
import { schemeClass } from "@wocart/theme";
import type { StoreMenu } from "@wocart/storefront";
import { Icon } from "astro-icon/components";
import CartBadge from "@/theme/components/cart/CartBadge.astro";
import LanguageSwitcher from "@/theme/components/layout/LanguageSwitcher.astro";
import { menuLinks } from "@/theme/runtime/navigation";
import type { header } from "@/theme/catalog/header/header.def";

type Props = InferProps<typeof header> & { storeMenu: StoreMenu | null };

const { storeMenu, logoPosition, logoWidth, sticky, showSearch, showLanguage, scheme } = Astro.props;
const store = Astro.locals.store;
const { config, content } = store;
const links = menuLinks(storeMenu, store.href, store.pathname) ?? [];
const centered = logoPosition === "center";
---

<header
  class:list={["site-header", schemeClass(scheme), sticky && "is-sticky", centered ? "is-centered" : "is-start"]}
  style={`--logo-w: ${logoWidth}px`}
>
  <div class="header-bar frame">
    {links.length > 0 && (
      <button type="button" popovertarget="site-menu" class="icon-btn header-menu-button" aria-label={content.navMenu}>
        <Icon name="heroicons:bars-3" aria-hidden="true" />
      </button>
    )}
    <a href={store.href("/")} class="header-logo" aria-label={config.name}>
      {config.logo ? (
        <Image src={config.logo.url} alt={config.name} width={480} height={160} fit="scale-down" quality={90} loading="eager" decoding="async" />
      ) : (
        <span class="header-name">{config.name}</span>
      )}
    </a>
    {links.length > 0 && (
      <nav class="header-nav" aria-label={content.ariaMainNavigation}>
        {links.map((link) =>
          link.children.length === 0 ? (
            <a href={link.href} aria-current={link.active ? "page" : undefined} class="nav-link" rel={link.external ? "noopener" : undefined}>{link.label}</a>
          ) : (
            <div class="nav-group">
              <a href={link.href} aria-current={link.active ? "page" : undefined} class="nav-link" aria-haspopup="true" rel={link.external ? "noopener" : undefined}>
                {link.label}
                <Icon name="heroicons:chevron-down" class="nav-caret" aria-hidden="true" />
              </a>
              <ul class="nav-panel">
                {link.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={child.active ? "page" : undefined} class="nav-panel-link" rel={child.external ? "noopener" : undefined}>{child.label}</a>
                    {child.children.length > 0 && (
                      <ul>
                        {child.children.map((grandchild) => (
                          <li>
                            <a href={grandchild.href} aria-current={grandchild.active ? "page" : undefined} class="nav-panel-link is-sub" rel={grandchild.external ? "noopener" : undefined}>{grandchild.label}</a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ),
        )}
      </nav>
    )}
    <div class="header-end">
      {showLanguage && <LanguageSwitcher />}
      {showSearch && (
        <a href={store.href("/search")} class="icon-btn" aria-label={content.searchLabel}>
          <Icon name="heroicons:magnifying-glass" aria-hidden="true" />
        </a>
      )}
      {config.cartEnabled && <CartBadge content={content} />}
    </div>
  </div>
</header>

{links.length > 0 && (
  <nav id="site-menu" popover class:list={["site-menu", schemeClass(scheme)]} aria-label={content.ariaMainNavigation}>
    <div class="site-menu-head">
      <span class="header-name">{config.name}</span>
      <button type="button" popovertarget="site-menu" popovertargetaction="hide" class="icon-btn" aria-label={content.navMenuClose}>
        <Icon name="heroicons:x-mark" aria-hidden="true" />
      </button>
    </div>
    <ul class="site-menu-list">
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={link.active ? "page" : undefined} class="site-menu-link" rel={link.external ? "noopener" : undefined}>{link.label}</a>
          {link.children.length > 0 && (
            <ul class="site-menu-sub">
              {link.children.flatMap((child) => [child, ...child.children]).map((child) => (
                <li>
                  <a href={child.href} aria-current={child.active ? "page" : undefined} class="site-menu-sublink" rel={child.external ? "noopener" : undefined}>{child.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .site-header {
    position: relative;
    z-index: 50;
    border-bottom: 1px solid var(--clr-border);
  }
  .site-header.is-sticky {
    position: sticky;
    top: 0;
    background: var(--clr-nav-bg);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
  }
  /* A phone: the menu, the logo in the middle, the icons. A wide screen: the
     logo, the menu in the middle, the icons — or the menu around a centered logo. */
  .header-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: "menu logo end";
    align-items: center;
    gap: 0.5rem;
    height: var(--header-h);
  }
  .header-menu-button { grid-area: menu; justify-self: start; }
  .header-logo { grid-area: logo; }
  .header-nav { grid-area: nav; display: none; }
  .header-end { grid-area: end; display: flex; align-items: center; justify-content: flex-end; gap: 0.125rem; }
  @media (min-width: 1024px) {
    .header-menu-button { display: none; }
    .header-nav { display: flex; }
    .is-start .header-bar { grid-template-columns: auto 1fr auto; grid-template-areas: "logo nav end"; gap: 2.5rem; }
    .is-start .header-nav { justify-content: center; }
    .is-centered .header-bar { grid-template-columns: 1fr auto 1fr; grid-template-areas: "nav logo end"; gap: 2rem; }
    .is-centered .header-nav { justify-content: flex-start; }
  }
  .header-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 0;
    color: var(--clr-ink);
    text-decoration: none;
  }
  .header-logo :global(img) {
    width: auto;
    height: auto;
    max-width: min(var(--logo-w), 40vw);
    max-height: 2.75rem;
    object-fit: contain;
  }
  .header-name {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 50vw;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    color: var(--clr-ink);
  }
  @media (min-width: 1024px) { .header-name { font-size: var(--text-2xl); max-width: none; } }

  .header-nav { align-items: center; gap: 0.5rem; min-width: 0; }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--clr-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.375rem;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform 0.3s var(--ease-out-expo);
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after { transform: scaleX(1); }
  .nav-link :global(.nav-caret) { width: 0.875rem; height: 0.875rem; opacity: 0.6; }
  .nav-group { position: relative; }
  .nav-panel {
    position: absolute;
    inset-inline-start: 0;
    top: 100%;
    z-index: 60;
    min-width: 14rem;
    padding: 0.5rem;
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.25rem);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  .nav-group:hover .nav-panel,
  .nav-group:focus-within .nav-panel { opacity: 1; visibility: visible; transform: none; }
  .nav-panel-link {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
    color: var(--clr-text);
    text-decoration: none;
    border-radius: var(--radius-input);
  }
  .nav-panel-link:hover,
  .nav-panel-link[aria-current="page"] { color: var(--clr-ink); background: var(--clr-plate); }
  .nav-panel-link.is-sub { padding-inline-start: 1.5rem; }

  /* The phone menu: a drawer from the start side. */
  .site-menu {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(22rem, 88vw);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: calc(var(--safe-top) + 0.25rem) 1.25rem calc(var(--safe-bottom) + 1.5rem);
    overflow-y: auto;
    border: 0;
    box-shadow: var(--shadow-lg);
    transform: translateX(-100%);
    transition: transform 0.4s var(--ease-out-expo), overlay 0.4s allow-discrete, display 0.4s allow-discrete;
  }
  [dir="rtl"] .site-menu { inset: 0 0 0 auto; transform: translateX(100%); }
  .site-menu:popover-open { transform: none; }
  @starting-style {
    .site-menu:popover-open { transform: translateX(-100%); }
    [dir="rtl"] .site-menu:popover-open { transform: translateX(100%); }
  }
  .site-menu::backdrop { background: var(--clr-overlay); }
  .site-menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
    border-bottom: 1px solid var(--clr-border);
    margin-bottom: 0.5rem;
  }
  .site-menu-list > li { border-bottom: 1px solid var(--clr-border); }
  .site-menu-link {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--clr-ink);
    text-decoration: none;
  }
  .site-menu-link[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 0.4em; }
  .site-menu-sub { padding-bottom: 0.75rem; }
  .site-menu-sublink {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    font-size: var(--text-base);
    color: var(--clr-text);
    text-decoration: none;
  }
</style>
