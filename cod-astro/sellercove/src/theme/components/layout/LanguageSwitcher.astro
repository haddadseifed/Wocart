---
// The store's published languages as plain links to this same page in each:
// crawlable, no script, absent while a store serves one language and on a
// page that exists in the primary language only (a landing page). Shoppers
// choose; nothing is ever redirected by browser language.
//
// A native popover holds the list, so the header carries one compact trigger
// at every width: the browser handles open, light dismiss, Escape and focus.
import { isSingleLanguagePage, localizeHref, servedLanguage } from "@wocart/storefront";
import { Icon } from "astro-icon/components";

const store = Astro.locals.store;
const languages = (isSingleLanguagePage(store.pathname) ? [] : store.routing.published).map((code) => ({
  code,
  name: servedLanguage(store.config, code)?.nativeName ?? code,
  href: `${localizeHref(store.pathname, code, store.routing)}${Astro.url.search}`,
}));
const current = languages.find((language) => language.code === store.locale);
---

{languages.length > 1 && (
  <div class="lang">
    <button
      type="button"
      class="lang-trigger"
      popovertarget="lang-menu"
    >
      <Icon name="heroicons:language" class="h-5 w-5" aria-hidden="true" />
      <span class="lang-code">{store.locale.toUpperCase()}</span>
      <span class="sr-only">{current?.name}</span>
    </button>
    <nav id="lang-menu" popover class="lang-menu" aria-label={store.content.ariaLanguageSwitcher}>
      <ul>
        {languages.map((language) => (
          <li>
            <a
              href={language.href}
              data-astro-reload
              hreflang={language.code}
              lang={language.code}
              aria-current={language.code === store.locale ? "true" : undefined}
              class="lang-option"
            >
              <span>{language.name}</span>
              <span class="lang-option-code" aria-hidden="true">{language.code.toUpperCase()}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
)}

<style>
  .lang { position: relative; anchor-name: --lang; }

  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    border: 1px solid var(--clr-clear);
    border-radius: var(--radius-btn);
    background: var(--clr-clear);
    color: var(--clr-ink);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
  }
  .lang-trigger:hover { border-color: var(--clr-border); }
  .lang-code { font-variant-numeric: tabular-nums; letter-spacing: 0.04em; }

  .lang-menu {
    margin: 0;
    padding: 0.375rem;
    border: 1.5px solid var(--clr-ink);
    border-radius: var(--radius-card);
    background: var(--clr-surface);
    color: var(--clr-ink);
    box-shadow: var(--shadow-lg);
    inset: auto 0.75rem calc(0.75rem + var(--safe-bottom)) 0.75rem;
    width: auto;
  }
  .lang-menu::backdrop { background: var(--clr-overlay); }
  .lang-menu ul { list-style: none; margin: 0; padding: 0; }

  @media (min-width: 640px) {
    .lang-menu {
      inset: auto;
      min-width: 12rem;
      position: fixed;
      top: calc(var(--header-h) + var(--safe-top) - 0.25rem);
      inset-inline-end: 1.5rem;
    }
    .lang-menu::backdrop { background: var(--clr-clear); }
    @supports (position-anchor: --lang) {
      .lang-menu {
        position-anchor: --lang;
        top: anchor(bottom);
        inset-inline-end: anchor(end);
        margin-top: 0.25rem;
      }
    }
  }

  .lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-input);
    color: var(--clr-ink);
    font-size: var(--text-base);
    font-weight: 500;
    text-decoration: none;
  }
  .lang-option:hover { background: var(--clr-plate); }
  .lang-option[aria-current="true"] { font-weight: 700; }
  .lang-option[aria-current="true"] .lang-option-code {
    background: var(--clr-primary);
    color: var(--clr-on-primary);
    border-color: var(--clr-primary);
  }
  .lang-option-code {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-tag);
    font-size: var(--text-2xs);
    font-weight: 700;
    color: var(--clr-text);
  }
</style>
