---
// Previous and next links for a product listing. Each page is a plain address
// (`?page=n`, keeping the order chosen), so a shopper can share it, reload it,
// and use the back button. When the listing knows its size, the pill says
// which page of how many.
import { Icon } from "astro-icon/components";
import type { ProductSort } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import { message } from "@/theme/content/messages";
import { listingHref, pageCount } from "@/theme/utils/pagination";

interface Props {
  basePath: string;
  page: number;
  hasNext: boolean;
  /** How many products the whole listing holds. */
  total: number;
  sort?: ProductSort | undefined;
  /** Fields every page keeps, such as a search's words. */
  keep?: Record<string, string>;
  content: StoreFrontContent;
}

const { basePath, page, hasNext, total, sort, keep = {}, content } = Astro.props;
const pageHref = (n: number) => listingHref(basePath, n, sort, keep);
const pages = pageCount(total);
const known = pages >= page;
---

{(page > 1 || hasNext) && (
  <nav aria-label={content.pagerLabel} class="pager">
    {page > 1 ? (
      <a href={pageHref(page - 1)} rel="prev" data-astro-prefetch="hover" class="btn-secondary btn-auto pager-link">
        <Icon name="heroicons:chevron-right" class="flip-ltr" aria-hidden="true" />
        {content.pagerPrevious}
      </a>
    ) : (
      <span></span>
    )}
    <span class:list={["pager-page num", known && "is-of"]} aria-current="page" aria-label={known ? message(content, "pagerPageOf", { page, pages }, Astro.locals.store.locale) : undefined} dir="ltr">{known ? `${page} / ${pages}` : page}</span>
    {hasNext ? (
      <a href={pageHref(page + 1)} rel="next" data-astro-prefetch="hover" class="btn-secondary btn-auto pager-link">
        {content.pagerNext}
        <Icon name="heroicons:chevron-left" class="flip-ltr" aria-hidden="true" />
      </a>
    ) : (
      <span></span>
    )}
  </nav>
)}

<style>
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; margin-top: 3rem; }
  .pager > :last-child { justify-self: end; }
  .pager-link { gap: 0.5rem; }
  .pager-link :global(svg) { width: 1rem; height: 1rem; }
  :global([dir="ltr"]) .pager :global(.flip-ltr) { transform: scaleX(-1); }
  .pager-page { display: grid; place-items: center; min-width: 2.5rem; height: 2.5rem; border-radius: var(--radius-round); background: var(--clr-ink); color: var(--clr-bg); font-size: var(--text-sm); }
  .pager-page.is-of { padding-inline: 0.875rem; }
</style>
