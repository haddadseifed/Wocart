---
// A text page of the store under its title: its terms, its delivery or
// returns policy, a page of its own. The body arrives already sanitised (at
// the platform's write) and is rendered as given, never re-sanitised here.
import type { InferProps } from "@wocart/theme";
import { schemeClass, styleClasses } from "@wocart/theme";
import type { StorePagePublic } from "@wocart/storefront";
import { storefrontPath } from "@wocart/storefront";
import { Icon } from "astro-icon/components";
import type { pageMain } from "@/theme/catalog/listing/page-main.def";

type Props = InferProps<typeof pageMain> & { page?: StorePagePublic | null };
const { page, headerAlign, showBreadcrumbs, headScheme, scheme, style } = Astro.props;
const store = Astro.locals.store;
const { content } = store;
const outer = styleClasses(style?.spacing ? { spacing: style.spacing } : undefined);
const width = styleClasses(style?.size ? { size: style.size } : undefined);
---

{page && (
  <article class:list={["text-page", schemeClass(scheme)]} aria-labelledby="page-title">
    <header class:list={["page-head", schemeClass(headScheme), headerAlign === "center" && "is-center"]}>
      <div class:list={["frame", width]}>
        {showBreadcrumbs && (
          <nav class="crumbs" aria-label={content.ariaBreadcrumb}>
            <a href={store.href(storefrontPath("home"))}>{content.navHome}</a>
            <Icon name="heroicons:chevron-left" class="crumb-sep flip-ltr" aria-hidden="true" />
            <span aria-current="page">{page.title}</span>
          </nav>
        )}
        <h1 id="page-title" class="page-title">{page.title}</h1>
      </div>
    </header>
    <div class:list={["page-body", outer]}>
      <div class:list={["frame", width]}>
        {page.bodyHtml.trim() === "" ? <p class="page-empty">{content.pageEmpty}</p> : <div class="rich-description page-text" set:html={page.bodyHtml} />}
      </div>
    </div>
  </article>
)}

<style>
  .page-head { padding-block: 1.75rem 2rem; }
  .page-head.is-center { text-align: center; }
  .page-head.is-center .crumbs { justify-content: center; }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; margin-bottom: 0.75rem; color: var(--clr-muted); font-size: var(--text-xs); }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--clr-ink); }
  .crumbs [aria-current] { color: var(--clr-ink); }
  .crumbs :global(.crumb-sep) { width: 0.75rem; height: 0.75rem; }
  :global([dir="ltr"]) .crumbs :global(.flip-ltr) { transform: scaleX(-1); }
  .page-title { font-size: var(--text-3xl); line-height: var(--text-3xl--line-height); font-weight: 600; color: var(--clr-ink); }
  .page-text { color: var(--clr-text); font-size: var(--text-base); line-height: 1.9; }
  .page-empty { color: var(--clr-muted); text-align: center; }
  @media (min-width: 1024px) {
    .page-head { padding-block: 2.75rem 3rem; }
    .page-title { font-size: var(--text-4xl); line-height: var(--text-4xl--line-height); }
    .page-text { font-size: var(--text-md); }
  }
</style>
