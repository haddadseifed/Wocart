---
// The order's confirmation (`thank-you-main`): its number and total, how it
// is paid, the steps that follow and the ways on, in the merchant's words.
import { Icon } from "astro-icon/components";
import { canonicalUrl, storefrontPath } from "@wocart/storefront";
import type { InferProps } from "@wocart/theme";
import Section from "@/theme/components/ui/Section.astro";
import type { StoreFrontContent } from "@/theme/content";
import type { thankYouMain } from "@/theme/catalog/thank-you/thank-you-main.def";
import { formatAmount } from "@/theme/utils/money";
import { storeWhatsApp } from "@/theme/utils/whatsapp";

type Props = Pick<InferProps<typeof thankYouMain>, "showSteps" | "showTrackOrder" | "scheme" | "style"> & {
  content: StoreFrontContent;
  order: { number: string; total: number | null };
};

const { content, order, showSteps = true, showTrackOrder = true, scheme, style } = Astro.props;
const store = Astro.locals.store;
const { config, isRTL } = store;
const whatsapp = storeWhatsApp(store, { kind: "order", order: order.number, url: canonicalUrl(Astro.url.origin, store, Astro.url.search) });
const totalFormatted = order.total !== null ? formatAmount(order.total) : null;
const steps = [
  { icon: "heroicons:phone", title: content.step1Title, sub: content.step1Sub },
  { icon: "heroicons:cube", title: content.step2Title, sub: content.step2Sub },
  { icon: "heroicons:truck", title: content.step3Title, sub: content.step3Sub },
];
---

<Section scheme={scheme} style={style}>
    <div class="text-center">
      <!-- Success icon -->
      <div
        class="w-24 h-24 rounded-[2rem] flex items-center justify-center mx-auto mb-8 shadow-xl animate-spring"
        style="background: var(--clr-surface); border: 4px solid color-mix(in srgb, var(--clr-primary) 10%, var(--clr-surface)); color: var(--clr-primary)"
      >
        <Icon name="heroicons:check-circle" class="w-12 h-12" />
      </div>
      <h1 class="text-3xl font-black mb-3 tracking-tight" style="color: var(--clr-ink)">
        {content.thankYouTitle}
      </h1>
      <p class="font-bold text-[1.0625rem] mb-10 text-balance px-4" style="color: var(--clr-text)">
        {content.thankYouSubtitle}
      </p>
      <!-- Order card (Ticket style) -->
      <div class="relative rounded-[2rem] border border-[var(--clr-border)] shadow-lg p-8 mb-10 text-start overflow-hidden" style="background: var(--clr-surface)">
        <div class="absolute -left-3 top-1/2 -translate-y-1/2 w-6 h-6 bg-[var(--clr-bg)] rounded-full border-r border-[var(--clr-border)]"></div>
        <div class="absolute -right-3 top-1/2 -translate-y-1/2 w-6 h-6 bg-[var(--clr-bg)] rounded-full border-l border-[var(--clr-border)]"></div>
        <div class="flex items-center justify-between pb-6 border-b border-dashed mb-6" style="border-color: var(--clr-border)">
          <span class="text-[0.6875rem] font-black uppercase tracking-[0.2em]" style="color: var(--clr-text)">
            {content.orderNumberLabel}
          </span>
          <span
            class="font-black text-xl tracking-wider"
            style="color: var(--clr-primary)"
          >
            {order.number}
          </span>
        </div>
        {totalFormatted && (
          <div class="flex items-center justify-between mb-6">
            <span class="text-sm font-bold" style="color: var(--clr-text)">{content.totalAmountLabel}</span>
            <span class="font-black text-2xl tracking-tight" style="color: var(--clr-ink)">
              {totalFormatted} <span class="text-sm opacity-60 font-bold tracking-tighter uppercase">{config.currencySymbol}</span>
            </span>
          </div>
        )}
        {/* WhatsApp inline button for thank-you page */}
        {whatsapp && (
          <a
            href={whatsapp.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2.5 w-full py-3.5 px-4 rounded-2xl font-bold text-sm tracking-tight transition-all active:scale-[0.98] mb-6"
            style={whatsapp.accent === 'primary' ? 'background: var(--clr-primary); color: var(--clr-on-primary); box-shadow: var(--shadow-sm);' : 'background: var(--clr-whatsapp); color: var(--clr-on-whatsapp); box-shadow: var(--shadow-sm);'}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>{whatsapp.orderButtonLabel}</span>
          </a>
        )}
        <div class="p-4 rounded-2xl border" style="background: var(--clr-plate); border-color: var(--clr-border)">
          <p class="text-[0.8125rem] font-black leading-relaxed flex items-center gap-2" style="color: var(--clr-text)">
            <Icon name="heroicons:credit-card" class="w-5 h-5 shrink-0 text-primary" />
            {content.codNote}
          </p>
        </div>
      </div>
      {showSteps && (
      <div class="grid grid-cols-3 gap-3 mb-12">
        {steps.map((step) => (
          <div class="flex flex-col items-center gap-2">
            <div
              class="w-12 h-12 rounded-2xl flex items-center justify-center shadow-sm border border-[var(--clr-border)] text-primary"
              style="background: var(--clr-surface)"
            >
              <Icon name={step.icon} class="w-5 h-5" />
            </div>
            <p class="text-[0.75rem] font-black leading-tight" style="color: var(--clr-ink)">{step.title}</p>
            <p class="text-[0.625rem] font-bold" style="color: var(--clr-text)">{step.sub}</p>
          </div>
        ))}
      </div>
      )}
      {showTrackOrder && (
      <a
        href={`${Astro.locals.store.href(storefrontPath("trackOrder"))}?${new URLSearchParams({ order: order.number })}`}
        class="btn-secondary mb-3"
      >
        <Icon name="heroicons:truck" class="w-5 h-5" />
        {content.trackTitle}
      </a>
      )}
      <a
        href={Astro.locals.store.href("/")}
        class="btn-primary !h-[3.75rem] !text-[1rem] active:scale-95 shadow-xl shadow-[var(--clr-primary)]/20"
      >
        {content.backToStore}
        <Icon name="heroicons:arrow-right" class:list={["w-5 h-5", isRTL ? 'rotate-180' : '']} />
      </a>
    </div>
</Section>
