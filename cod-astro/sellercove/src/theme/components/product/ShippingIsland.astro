---
/**
 * ShippingIsland.astro
 * Fetches shipping rates on the server and injects them as a JSON bridge
 * for the client-side product script.
 */

// No props: the island renders the rate table straight from the SDK, so there
// is nothing in the encrypted island URL but the id of the island itself.
const shippingRates = await Astro.locals.store.client.shipping.rates();
---

<div
  id="shipping-rates-data"
  class="hidden"
  data-rates={JSON.stringify(shippingRates)}
></div>
