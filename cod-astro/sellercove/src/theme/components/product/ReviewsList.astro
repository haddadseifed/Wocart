---
// A product's reviews: the summary a shopper reads first (the average over
// all its reviews, the stars, how many), then each review as a carton — its
// photos small until opened, its voice note loaded only when played, and the
// verified-purchase stamp only when the review rests on a delivered order.
// "Load more" clones the card template and fills it with text and media URLs
// only: a review is shopper-written, so none of it is ever parsed as markup.
import { message } from "@/theme/content/messages";
import VoicePlayer from "@/theme/components/product/VoicePlayer.astro";
import { STOREFRONT_API_PATHS, type Review, type ReviewMedia } from "@wocart/storefront";
import type { ReviewsListCopy } from "@/theme/bridges/island-props";
import { Icon } from "astro-icon/components";

interface Props {
  reviews: Review[];
  total: number;
  stats: { avgRating: number; reviewCount: number } | null;
  copy: ReviewsListCopy;
  productId: string;
}

const { reviews, total, stats, copy, productId } = Astro.props;
const locale = Astro.locals.store?.locale ?? "ar";

const pageAverage = reviews.length ? reviews.reduce((sum, review) => sum + review.rating, 0) / reviews.length : 0;
const avgRating = Math.round((stats?.reviewCount ? stats.avgRating : pageAverage) * 10) / 10;
const count = stats?.reviewCount || total;
/** The spread of ratings is shown only when every review is on the page. */
const dist = reviews.length >= total && total >= 3
  ? [5, 4, 3, 2, 1].map((star) => ({ star, count: reviews.filter((review) => review.rating === star).length }))
  : null;

const dateFormat = new Intl.DateTimeFormat(locale, { year: "numeric", month: "long", day: "numeric" });
function formatDate(val: string): string {
  const n = Number(val);
  const d = Number.isNaN(n) ? new Date(val) : new Date(n);
  return Number.isNaN(d.getTime()) ? val.slice(0, 10) : dateFormat.format(d);
}
const starLabel = (n: number) => message(copy, "ariaStarRating", { count: n }, locale);
const playerCopy = {
  label: copy.reviewsVoiceNote,
  play: copy.reviewsPlayVoice,
  pause: copy.reviewsPauseVoice,
  seek: copy.reviewsSeekVoice,
  retry: copy.reviewsVoiceRetry,
  error: copy.reviewsVoiceError,
  position: copy.reviewsVoicePosition,
};
const photoLabel = (index: number) => message(copy, "reviewsOpenPhoto", { index }, locale);
const photos = (review: Review) => review.media.filter((item: ReviewMedia) => item.kind === "image");
const voice = (review: Review) => review.media.find((item: ReviewMedia) => item.kind === "audio") ?? null;
---

{reviews.length > 0 && (
<section class="reviews-section" data-product-id={productId}>
  <div class="review-summary carton">
    <div class="flex items-center gap-4">
      <p class="num text-4xl font-bold leading-none text-ink">{avgRating.toFixed(1)}</p>
      <div class="flex flex-col gap-1">
        <p class="flex items-center gap-0.5" role="img" aria-label={starLabel(Math.round(avgRating))}>
          {[1, 2, 3, 4, 5].map((s) => (
            <Icon name="heroicons:star-solid" class:list={["h-4 w-4", s <= Math.round(avgRating) ? "text-ink" : "text-border"]} aria-hidden="true" />
          ))}
        </p>
        <p class="num text-sm text-ink-2">({count})</p>
      </div>
    </div>

    {dist && (
      <ul class="review-dist" aria-hidden="true">
        {dist.map(({ star, count: n }) => (
          <li>
            <span class="num w-3 text-xs text-ink-2">{star}</span>
            <span class="review-bar"><span style={`inline-size: ${Math.round((n / total) * 100)}%`} /></span>
            <span class="num w-6 text-end text-xs text-ink-2">{n}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <ul class="mt-4 grid grid-cols-1 gap-3 sm:gap-4" id="reviews-list">
    {reviews.map((review) => (
      <li class="carton flex flex-col gap-3 p-5">
        <p class="flex items-center gap-0.5" role="img" aria-label={starLabel(review.rating)}>
          {[1, 2, 3, 4, 5].map((s) => (
            <Icon name="heroicons:star-solid" class:list={["h-4 w-4", s <= review.rating ? "text-ink" : "text-border"]} aria-hidden="true" />
          ))}
        </p>
        {review.title && <p class="text-base font-bold text-ink" dir="auto">{review.title}</p>}
        {review.body && <p class="text-sm leading-relaxed text-ink" dir="auto">{review.body}</p>}
        {voice(review) && <VoicePlayer src={voice(review)!.url} durationMs={voice(review)!.durationMs} copy={playerCopy} />}
        {photos(review).length > 0 && (
          <ul class="flex flex-wrap gap-2">
            {photos(review).map((photo, index) => (
              <li>
                <button type="button" class="block h-16 w-16 overflow-hidden rounded-[var(--radius-input)] bg-plate" data-review-photo={photo.url} aria-label={photoLabel(index + 1)}>
                  <img src={photo.thumbUrl ?? photo.url} alt="" loading="lazy" decoding="async" width="64" height="64" class="h-full w-full object-cover" />
                </button>
              </li>
            ))}
          </ul>
        )}
        <footer class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-border pt-3">
          <span class="min-w-0 truncate text-sm font-semibold text-ink" dir="auto">{review.customerName}</span>
          {review.verified && (
            <span class="stamp stamp-line shrink-0">
              <Icon name="heroicons:check-circle" class="h-3.5 w-3.5 text-success" aria-hidden="true" />
              {copy.reviewsVerifiedBuyer}
            </span>
          )}
          <time class="ms-auto text-xs text-ink-2" datetime={review.createdAt}>{formatDate(review.createdAt)}</time>
        </footer>
      </li>
    ))}
  </ul>

  {/* The card a loaded review fills — text and media URLs only, never markup. */}
  <template id="review-card-template">
    <li class="carton flex flex-col gap-3 p-5">
      <p class="flex items-center gap-0.5" role="img" data-review-stars>
        {[1, 2, 3, 4, 5].map((s) => (
          <Icon name="heroicons:star-solid" class="h-4 w-4 text-border" data-star={s} aria-hidden="true" />
        ))}
      </p>
      <p class="text-base font-bold text-ink" dir="auto" data-review-title hidden></p>
      <p class="text-sm leading-relaxed text-ink" dir="auto" data-review-body hidden></p>
      <div data-review-voice hidden>
        <VoicePlayer src="" durationMs={null} copy={playerCopy} />
      </div>
      <ul class="flex flex-wrap gap-2" data-review-photos hidden></ul>
      <footer class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-border pt-3">
        <span class="min-w-0 truncate text-sm font-semibold text-ink" dir="auto" data-review-name></span>
        <span class="stamp stamp-line shrink-0" data-review-verified hidden>
          <Icon name="heroicons:check-circle" class="h-3.5 w-3.5 text-success" aria-hidden="true" />
          {copy.reviewsVerifiedBuyer}
        </span>
        <time class="ms-auto text-xs text-ink-2" data-review-date></time>
      </footer>
    </li>
  </template>

  <dialog class="review-viewer carton p-0" data-review-viewer>
    <form method="dialog" class="flex justify-end p-2">
      <button type="submit" class="btn-secondary !w-auto">
        <Icon name="heroicons:x-mark" class="h-4 w-4" aria-hidden="true" />
        {copy.reviewsClosePhoto}
      </button>
    </form>
    <img alt="" class="block max-h-[80dvh] w-auto max-w-full object-contain" data-review-viewer-image />
  </dialog>

  {total > reviews.length && (
    <div class="mt-6 flex justify-center">
      <button
        type="button"
        id="load-more-reviews"
        data-product-id={productId}
        data-offset={reviews.length}
        class="btn-secondary !w-auto"
      >
        {copy.loadMoreLabel}
      </button>
    </div>
  )}
</section>
)}

<style>
  .reviews-section .review-summary {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
  }
  @media (min-width: 640px) {
    .reviews-section .review-summary {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
  }
  .review-dist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-inline-size: 12rem;
    flex: 1;
    max-inline-size: 20rem;
  }
  .review-dist li { display: flex; align-items: center; gap: 0.5rem; }
  .review-bar {
    flex: 1;
    block-size: 0.375rem;
    background: var(--clr-plate);
    border-radius: var(--radius-tag);
    overflow: hidden;
  }
  .review-bar > span {
    display: block;
    block-size: 100%;
    background: var(--clr-ink);
  }
  .review-viewer {
    max-inline-size: min(48rem, calc(100vw - 2rem));
  }
  .review-viewer::backdrop {
    background: color-mix(in srgb, var(--clr-ink) 60%, transparent);
  }
</style>

<script is:inline data-astro-rerun define:vars={{ reviewsPath: STOREFRONT_API_PATHS.reviewsList, loadMoreLabel: copy.loadMoreLabel, locale, starLabels: [1, 2, 3, 4, 5].map((n) => starLabel(n)), photoLabels: [1, 2, 3, 4, 5, 6].map((n) => photoLabel(n)) }}>
  (function () {
    const section = document.querySelector(".reviews-section");
    if (!section) return;
    const viewer = section.querySelector("[data-review-viewer]");
    const viewerImage = section.querySelector("[data-review-viewer-image]");
    const safe = (url) => typeof url === "string" && /^(https?:)?\/\//.test(url) || (typeof url === "string" && url.startsWith("/"));

    section.addEventListener("click", (event) => {
      const button = event.target.closest("[data-review-photo]");
      if (!button || !viewer || !viewerImage) return;
      viewerImage.src = button.dataset.reviewPhoto;
      viewer.showModal();
    });
    viewer?.addEventListener("click", (event) => {
      if (event.target === viewer) viewer.close();
    });

    const btn = document.getElementById("load-more-reviews");
    const template = document.getElementById("review-card-template");
    const list = document.getElementById("reviews-list");
    if (!btn || !template || !list) return;

    let dateFormat;
    try {
      dateFormat = new Intl.DateTimeFormat(locale, { year: "numeric", month: "long", day: "numeric" });
    } catch {
      dateFormat = null;
    }
    function formatDate(value) {
      const n = Number(value);
      const d = Number.isNaN(n) ? new Date(value) : new Date(n);
      if (!dateFormat || Number.isNaN(d.getTime())) return String(value).slice(0, 10);
      return dateFormat.format(d);
    }
    function formatDuration(ms) {
      if (!ms || ms <= 0) return "";
      const seconds = Math.round(ms / 1000);
      return Math.floor(seconds / 60) + ":" + String(seconds % 60).padStart(2, "0");
    }

    function card(review) {
      const node = template.content.firstElementChild.cloneNode(true);
      const rating = Math.max(0, Math.min(5, Number(review.rating) || 0));
      const stars = node.querySelector("[data-review-stars]");
      stars.setAttribute("aria-label", starLabels[Math.max(rating, 1) - 1] ?? "");
      stars.querySelectorAll("[data-star]").forEach((star) => {
        const on = Number(star.dataset.star) <= rating;
        star.classList.toggle("text-ink", on);
        star.classList.toggle("text-border", !on);
      });
      const title = node.querySelector("[data-review-title]");
      if (review.title) {
        title.textContent = review.title;
        title.hidden = false;
      }
      const body = node.querySelector("[data-review-body]");
      if (review.body) {
        body.textContent = review.body;
        body.hidden = false;
      }
      const media = Array.isArray(review.media) ? review.media : [];
      const voice = media.find((item) => item.kind === "audio" && safe(item.url));
      if (voice) {
        const holder = node.querySelector("[data-review-voice]");
        const player = holder.querySelector("[data-voice]");
        player.querySelector("[data-voice-audio]").src = voice.url;
        player.dataset.durationMs = String(Number(voice.durationMs) > 0 ? Number(voice.durationMs) : 0);
        const seek = player.querySelector("[data-voice-seek]");
        seek.max = String(Math.max(1, Math.round(Number(player.dataset.durationMs) / 1000)));
        seek.disabled = player.dataset.durationMs === "0";
        const length = formatDuration(voice.durationMs);
        player.querySelector("[data-voice-time]").textContent = length ? "0:00 / " + length : "0:00";
        holder.hidden = false;
      }
      const photos = media.filter((item) => item.kind === "image" && safe(item.url));
      if (photos.length) {
        const strip = node.querySelector("[data-review-photos]");
        photos.forEach((photo, index) => {
          const item = document.createElement("li");
          const button = document.createElement("button");
          button.type = "button";
          button.className = "block h-16 w-16 overflow-hidden rounded-[var(--radius-input)] bg-plate";
          button.dataset.reviewPhoto = photo.url;
          button.setAttribute("aria-label", photoLabels[index] ?? "");
          const image = document.createElement("img");
          image.src = safe(photo.thumbUrl) ? photo.thumbUrl : photo.url;
          image.alt = "";
          image.loading = "lazy";
          image.decoding = "async";
          image.width = 64;
          image.height = 64;
          image.className = "h-full w-full object-cover";
          button.appendChild(image);
          item.appendChild(button);
          strip.appendChild(item);
        });
        strip.hidden = false;
      }
      node.querySelector("[data-review-name]").textContent = review.customerName ?? "";
      node.querySelector("[data-review-verified]").hidden = review.verified !== true;
      const time = node.querySelector("[data-review-date]");
      time.textContent = formatDate(review.createdAt);
      time.setAttribute("datetime", String(review.createdAt ?? ""));
      return node;
    }

    btn.addEventListener("click", async () => {
      const productId = btn.dataset.productId;
      const offset = parseInt(btn.dataset.offset ?? "0", 10);

      btn.disabled = true;
      btn.setAttribute("aria-busy", "true");

      try {
        const res = await fetch(`${reviewsPath.replace(":productId", encodeURIComponent(productId))}?offset=${offset}&limit=10`);
        const json = await res.json();
        const rows = Array.isArray(json.data) ? json.data : [];
        rows.forEach((review) => list.appendChild(card(review)));

        const newOffset = offset + rows.length;
        btn.dataset.offset = String(newOffset);
        if (rows.length === 0 || newOffset >= (json.total ?? 0)) {
          btn.parentElement?.remove();
          return;
        }
      } catch {
        // The button stays: the shopper can try again.
      }
      btn.disabled = false;
      btn.removeAttribute("aria-busy");
      btn.textContent = loadMoreLabel;
    });
  })();
</script>
