---
// The product itself. Its gallery — a fixed block, always there — beside the
// column the merchant arranges: the name, the stars, the price, short facts,
// the order form (which can move but never leave), a countdown, the
// description and the store's policies. The gallery stays in view on a wide
// screen while the column scrolls. On a phone a bar with the price and the
// order action follows the shopper until the form is in view.
//
// It also carries what the page as a whole needs once: the product's
// structured data for search engines, the values the order script reads, and
// the delivery rates.
import Block from "@wocart/theme/astro/Block.astro";
import Blocks from "@wocart/theme/astro/Blocks.astro";
import type { BlocksHandle } from "@wocart/theme/astro";
import type { StyleValue } from "@wocart/theme";
import { canonicalUrl, getProductView, jsonLd, productStructuredData, storefrontPath, type Product } from "@wocart/storefront";
import { Icon } from "astro-icon/components";
import Section from "@/theme/components/ui/Section.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import { formatAmount } from "@/theme/utils/money";
import { pageDataCopy } from "@/theme/bridges/island-props";
import { PRODUCT_PAGE_DATA_ID, buildProductPageData } from "@/theme/bridges/product-page-data";

interface Props {
  blocks: BlocksHandle;
  product: Product | null;
  scheme?: string;
  style?: StyleValue;
}

const { blocks, product, scheme, style } = Astro.props;
const store = Astro.locals.store;
const { config, content, isRTL } = store;
const view = product ? getProductView(product) : null;
---

{product && view && (
  <>
    <script type="application/ld+json" set:html={jsonLd(productStructuredData(product, { url: canonicalUrl(Astro.url.origin, store), storeName: config.name }))} />
    <div
      id={PRODUCT_PAGE_DATA_ID}
      class="sr-only"
      {...buildProductPageData({ product, currencySymbol: config.currencySymbol, isRTL, basePrice: view.basePrice, copy: pageDataCopy(content) })}
    />
    <ShippingIsland server:defer />

    <Section scheme={scheme} style={style}>
      <nav class="crumbs" aria-label={content.ariaBreadcrumb}>
        <a href={store.href(storefrontPath("home"))}>{content.navHome}</a>
        {product.category && (
          <>
            <Icon name="heroicons:chevron-left" class="crumb-sep flip-ltr" aria-hidden="true" />
            <a href={store.href(storefrontPath("category", { slug: product.category.slug }))}>{product.category.name}</a>
          </>
        )}
        <Icon name="heroicons:chevron-left" class="crumb-sep flip-ltr" aria-hidden="true" />
        <span aria-current="page">{product.name}</span>
      </nav>
      <div class="pdp">
        <div class="pdp-gallery"><Block of={blocks} name="gallery" /></div>
        <div class="pdp-info"><Blocks of={blocks} slot="info" /></div>
      </div>
    </Section>

    {!view.isOutOfStock && (
      <a href="#order-section" id="product-sticky-cta" class="sticky-buy">
        <span class="sticky-buy-price">
          <small>{content.orderCtaSubtext}</small>
          <b class="num" id="sticky-price">{formatAmount(view.basePrice)}<span class="price-cur">{config.currencySymbol}</span></b>
        </span>
        <span class="btn-primary sticky-buy-cta">{content.orderCta}</span>
      </a>
    )}
  </>
)}

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    padding-block: 0.875rem;
    color: var(--clr-muted);
    font-size: var(--text-xs);
  }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--clr-ink); }
  .crumbs [aria-current] { overflow: hidden; color: var(--clr-ink); text-overflow: ellipsis; white-space: nowrap; max-width: 60vw; }
  .crumbs :global(.crumb-sep) { width: 0.75rem; height: 0.75rem; }
  :global([dir="ltr"]) .crumbs :global(.flip-ltr) { transform: scaleX(-1); }
  .pdp { display: grid; gap: 1.5rem; }
  .pdp-info { display: flex; flex-direction: column; gap: 1.125rem; min-width: 0; }
  @media (min-width: 1024px) {
    .crumbs { padding-block: 1rem 1.5rem; font-size: var(--text-sm); }
    .pdp { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3.5rem; align-items: start; }
    .pdp-gallery { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  }
  .sticky-buy {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem calc(0.625rem + var(--safe-bottom));
    background: var(--clr-nav-bg);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-top: 1px solid var(--clr-border);
    color: var(--clr-ink);
    text-decoration: none;
    transition: transform 0.3s var(--ease-out-expo), opacity 0.3s ease;
  }
  .sticky-buy.is-hidden { transform: translateY(110%); opacity: 0; pointer-events: none; }
  .sticky-buy-price { display: flex; flex-direction: column; line-height: 1.3; }
  .sticky-buy-price small { color: var(--clr-muted); font-size: var(--text-xs); }
  .sticky-buy-price b { font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 600; }
  .sticky-buy-cta { flex: 1; min-height: 3.125rem; }
  @media (min-width: 1024px) { .sticky-buy { display: none; } }
</style>
