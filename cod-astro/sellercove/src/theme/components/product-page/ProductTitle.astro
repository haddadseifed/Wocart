---
// The product's name, under its category when the merchant shows it.
import type { InferProps } from "@wocart/theme";
import { storefrontPath, type Product } from "@wocart/storefront";
import type { productTitle } from "@/theme/catalog/product/product-main.def";

type Props = InferProps<typeof productTitle> & { product: Product | null };
const { product, showCategory } = Astro.props;
const store = Astro.locals.store;
---

{product && (
  <div class="product-title">
    {showCategory && product.category && (
      <a href={store.href(storefrontPath("category", { slug: product.category.slug }))} class="product-category">{product.category.name}</a>
    )}
    <h1>{product.name}</h1>
  </div>
)}

<style>
  .product-title { display: grid; gap: 0.25rem; }
  .product-category { color: var(--clr-muted); font-size: var(--text-sm); text-decoration: none; }
  .product-category:hover { color: var(--clr-ink); }
  h1 { font-size: var(--text-2xl); line-height: 1.4; font-weight: 600; }
  @media (min-width: 1024px) { h1 { font-size: var(--text-3xl); line-height: 1.3; } }
</style>
