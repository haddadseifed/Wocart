---
// The band over the header. Several messages turn one at a time — paused
// while the shopper points at or focuses the bar, and never on their own
// for a shopper who asked for less motion; the arrows turn them by hand.
import Blocks from "@wocart/theme/astro/Blocks.astro";
import { hasBlocks, isPreview, type BlocksHandle } from "@wocart/theme/astro";
import { schemeClass } from "@wocart/theme";
import { Icon } from "astro-icon/components";

interface Props {
  blocks: BlocksHandle;
  scheme?: string;
  autoplay?: boolean;
}

const { blocks, scheme, autoplay = true } = Astro.props;
const content = Astro.locals.store.content;
const shown = hasBlocks(blocks, "default") || isPreview(blocks);
---

{shown && (
  <div class:list={["announce", schemeClass(scheme)]} data-announce data-autoplay={autoplay ? "" : undefined} style="padding-top: var(--safe-top)">
    <div class="announce-inner frame">
      <button type="button" class="announce-turn" data-announce-step="-1" aria-label={content.announcePrevious} hidden>
        <Icon name="heroicons:chevron-left" class="flip-rtl" aria-hidden="true" />
      </button>
      <div class="announce-track" aria-live="polite">
        <Blocks of={blocks} slot="default" />
      </div>
      <button type="button" class="announce-turn" data-announce-step="1" aria-label={content.announceNext} hidden>
        <Icon name="heroicons:chevron-right" class="flip-rtl" aria-hidden="true" />
      </button>
    </div>
  </div>
)}

<script>
  import { bindEach } from "@wocart/theme/lifecycle";

  const TURN_MS = 5000;

  bindEach("[data-announce]", (bar) => {
    const items = () => [...bar.querySelectorAll<HTMLElement>(".announce-item")];
    if (items().length < 2) return;
    let index = 0;
    let timer: number | undefined;
    const show = (next: number) => {
      const all = items();
      index = (next + all.length) % all.length;
      all.forEach((item, at) => item.toggleAttribute("data-active", at === index));
    };
    bar.setAttribute("data-ready", "");
    for (const button of bar.querySelectorAll<HTMLButtonElement>("[data-announce-step]")) {
      button.hidden = false;
      button.addEventListener("click", () => show(index + Number(button.dataset.announceStep)));
    }
    show(0);
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const start = () => {
      if (still || !bar.hasAttribute("data-autoplay")) return;
      stop();
      timer = window.setInterval(() => show(index + 1), TURN_MS);
    };
    const stop = () => window.clearInterval(timer);
    bar.addEventListener("pointerenter", stop);
    bar.addEventListener("pointerleave", start);
    bar.addEventListener("focusin", stop);
    bar.addEventListener("focusout", start);
    start();
    return stop;
  });
</script>

<style>
  .announce {
    position: relative;
    z-index: 51;
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
  }
  @media (min-width: 640px) { .announce { font-size: var(--text-sm); } }
  .announce-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.5rem;
  }
  .announce-track { flex: 1; min-width: 0; display: grid; }
  .announce-track :global(.announce-item) { grid-area: 1 / 1; padding-block: 0.5rem; }
  .announce-track :global(.announce-item ~ .announce-item) { visibility: hidden; }
  .announce[data-ready] .announce-track :global(.announce-item) { visibility: hidden; opacity: 0; transition: opacity 0.4s ease, visibility 0.4s; }
  .announce[data-ready] .announce-track :global(.announce-item[data-active]) { visibility: visible; opacity: 1; }
  .announce-track :global(.announce-link) { text-decoration: underline; text-decoration-color: color-mix(in oklab, currentColor 40%, transparent); }
  .announce-turn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: var(--radius-round);
    color: inherit;
    opacity: 0.75;
  }
  .announce-turn:hover { opacity: 1; }
  .announce-turn :global(svg) { width: 1rem; height: 1rem; }
</style>
