---
// How a cash-on-delivery order goes: three numbered steps — a real sequence —
// on cards in a band of the section's color.
import type { InferProps } from "@wocart/theme";
import type { StoreFrontContent } from "@/theme/content";
import type { howItWorks } from "@/theme/catalog/home/how-it-works.def";
import Section from "@/theme/components/ui/Section.astro";
import SectionHead from "@/theme/components/ui/SectionHead.astro";

type Props = Pick<InferProps<typeof howItWorks>, "scheme" | "style"> & { content: StoreFrontContent };

const { content, scheme, style } = Astro.props;
const steps = [
  { title: content.howStep1Title, sub: content.howStep1Sub },
  { title: content.howStep2Title, sub: content.howStep2Sub },
  { title: content.howStep3Title, sub: content.howStep3Sub },
].filter((step) => step.title);
---

<Section scheme={scheme} style={style}>
  <SectionHead title={content.howItWorksTitle} sub={content.howItWorksSub} center />
  <ol class="steps">
    {steps.map((step, index) => (
      <li class="step">
        <span class="step-number num" aria-hidden="true">{index + 1}</span>
        <div>
          <h3 class="step-title">{step.title}</h3>
          {step.sub && <p class="step-sub">{step.sub}</p>}
        </div>
      </li>
    ))}
  </ol>
</Section>

<style>
  .steps { display: grid; gap: 0.875rem; list-style: none; }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 1rem;
    padding: 1.375rem;
    border-radius: var(--radius-panel);
    background: var(--clr-field);
  }
  .step-number {
    display: inline-flex;
    width: 2.875rem;
    height: 2.875rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-round);
    background: var(--clr-primary);
    color: var(--clr-on-primary);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .step-title { font-size: var(--text-lg); font-weight: 600; }
  .step-sub { margin-top: 0.25rem; color: var(--clr-muted); font-size: var(--text-sm); }
  @media (min-width: 1024px) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
    .step { grid-template-columns: 1fr; gap: 1.25rem; padding: 2rem; }
    .step-title { font-size: var(--text-xl); }
  }
</style>
