---
// A closing band in the section's colors: one question, one line, one
// action. The button opens the store's WhatsApp when its contact widget is
// on, else the link the merchant set.
import { canonicalUrl } from "@wocart/storefront";
import type { InferProps } from "@wocart/theme";
import type { StoreFrontContent } from "@/theme/content";
import type { whatsappCta } from "@/theme/catalog/home/whatsapp-cta.def";
import { Icon } from "astro-icon/components";
import Section from "@/theme/components/ui/Section.astro";
import { storeWhatsApp } from "@/theme/utils/whatsapp";

type Props = Pick<InferProps<typeof whatsappCta>, "ctaHref" | "scheme" | "style"> & {
  content: StoreFrontContent;
};

const { content, ctaHref, scheme, style } = Astro.props;
const store = Astro.locals.store;
const whatsapp = storeWhatsApp(store, { kind: "general", url: canonicalUrl(Astro.url.origin, store, Astro.url.search) });
const href = whatsapp ? whatsapp.href : store.href(ctaHref);
---

<Section scheme={scheme} style={style}>
  <div class="band">
    <h2 class="band-title">{content.promoTitle}</h2>
    {content.promoSub && <p class="band-sub">{content.promoSub}</p>}
    {content.promoCtaText && (
      <a href={href} class:list={["band-cta", whatsapp && "is-whatsapp"]} rel={whatsapp ? "noopener" : undefined} target={whatsapp ? "_blank" : undefined}>
        {whatsapp && <Icon name="heroicons:chat-bubble-left-right" aria-hidden="true" />}
        {content.promoCtaText}
      </a>
    )}
  </div>
</Section>

<style>
  .band { display: flex; flex-direction: column; align-items: center; gap: 0.875rem; text-align: center; }
  .band-title { max-width: 40rem; font-size: var(--text-3xl); font-weight: 500; }
  .band-sub { max-width: 34rem; color: var(--clr-text); font-size: var(--text-md); }
  .band-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 3.25rem;
    margin-top: 0.75rem;
    padding-inline: 1.75rem;
    border-radius: var(--radius-btn);
    background: var(--clr-primary);
    color: var(--clr-on-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .band-cta.is-whatsapp { border-radius: var(--radius-round); background: var(--clr-whatsapp); color: var(--clr-on-whatsapp); }
  .band-cta :global(svg) { width: 1.25rem; height: 1.25rem; }
  @media (min-width: 1024px) { .band-title { font-size: var(--text-5xl); } .band-sub { font-size: var(--text-lg); } }
</style>
