---
import Select from "@/theme/components/ui/Select.astro";
import { Icon } from "astro-icon/components";
import { WILAYAS } from "@wocart/storefront";
import CustomFieldRow from "./CustomFieldRow.astro";
import type { CheckoutFormPolicy } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import type { FieldErrors } from "@/theme/types";

interface Props {
  content: StoreFrontContent;
  fieldErrors: FieldErrors;
  isRTL: boolean;
  /**
   * The merchant's order-form configuration, from `GET /store/config`.
   *
   * Optional, and defaulted to the form as it has always been, for two reasons:
   * a storefront running against a cod-server from before this feature gets no
   * policy at all, and every existing caller keeps working untouched.
   */
  formPolicy?: CheckoutFormPolicy;
}

const { content, fieldErrors, isRTL, formPolicy } = Astro.props;

const policy: CheckoutFormPolicy = {
  address: "optional",
  notes: "optional",
  email: "hidden",
  deliveryOptions: { home: true, stopDesk: true },
  customFields: [],
  ...(formPolicy ?? {}),
};

// A hidden field ships no markup at all — the same choice the cart makes when a
// merchant leaves it off. Rendering it disabled would still put it in the DOM,
// where a script or a curious shopper can turn it back on.
const showEmail = policy.email !== "hidden";
const showNotes = policy.notes !== "hidden";
const showAddress = policy.address !== "hidden";
const addressRequired = policy.address === "required";

// Both are never false: cod-shared repairs a policy with neither option on,
// because a form nobody can submit is worse than ignoring the setting.
const deliveryChoices = [
  { value: "home", icon: "heroicons:home", label: content.formHomeDelivery, on: policy.deliveryOptions.home },
  { value: "stop_desk", icon: "heroicons:truck", label: content.formStopDesk, on: policy.deliveryOptions.stopDesk },
].filter((choice) => choice.on);

// With one option there is nothing to choose. The card still renders — the
// shopper does want to know HOW the order arrives — and the radio still carries
// the value, but it stops behaving like a button: nothing happens when it is
// tapped, so it should not invite the tap. Nothing announces that the other
// option is missing either; a shopper cannot miss a choice they were never
// offered, and naming the absence only raises a question about it.
const singleDelivery = deliveryChoices.length === 1;

// A middle dot rather than an em dash: the option sits in a panel only as wide
// as its trigger, and the dash cost enough room to wrap the longer wilaya names
// onto a second line.
const wilayaOptions = WILAYAS.map((w) => ({
  value: w.id,
  label: `${w.id.toString().padStart(2, "0")} · ${isRTL ? w.nameAr : w.name}`,
}));
---

<div class="fields">
  <p class="sr-only">{content.formDeliverySection}</p>

  <!-- Name + Phone — paired so the two shortest answers cost one row, not two.
       Each label is kept for assistive tech and shown inside the field, which is
       what removes roughly a third of the scroll to the submit button. -->
  <div class="field-pair">
    <div class="field">
      <label for="f-name" class="sr-only">{content.formNameLabel}</label>
      <Icon name="heroicons:user" class="field-icon" aria-hidden="true" />
      <input
        id="f-name" type="text" name="customerName"
        required autocomplete="name"
        placeholder={`${content.formNameLabel} *`}
        class:list={["form-input", fieldErrors.customerName && "error"]}
        aria-invalid={fieldErrors.customerName ? "true" : undefined}
        aria-describedby={fieldErrors.customerName ? "f-name-error" : undefined}
      />
      {fieldErrors.customerName && (
        <p id="f-name-error" class="field-error">{fieldErrors.customerName[0]}</p>
      )}
    </div>

    <div class="field">
      <label for="f-phone" class="sr-only">{content.formPhoneLabel}</label>
      <Icon name="heroicons:phone" class="field-icon" aria-hidden="true" />
      <!-- No `dir="ltr"`: it would left-align the Arabic placeholder and break
           the row. Digits are laid out left-to-right by the bidi algorithm on
           their own, so the number still reads correctly as it is typed. -->
      <input
        id="f-phone" type="tel" name="phone"
        required autocomplete="tel" inputmode="tel"
        placeholder={`${content.formPhoneLabel} *`}
        class:list={["form-input", fieldErrors.phone && "error"]}
        aria-invalid={fieldErrors.phone ? "true" : undefined}
        aria-describedby={fieldErrors.phone ? "f-phone-error" : undefined}
      />
      {fieldErrors.phone && (
        <p id="f-phone-error" class="field-error">{fieldErrors.phone[0]}</p>
      )}
    </div>
  </div>

  {showEmail && (
    <div>
      <label for="f-email" class="sr-only">{content.formEmailLabel}</label>
      {/* `dir="ltr"` is safe here and wrong on the phone row above: this field
          is its own row, so aligning it left cannot break a neighbour's layout,
          and an address typed into an RTL field reads backwards without it. */}
      <input
        id="f-email" type="email" name="email"
        dir="ltr"
        required={policy.email === "required" || undefined}
        autocomplete="email" inputmode="email" maxlength="254"
        placeholder={policy.email === "required"
          ? `${content.formEmailLabel} *`
          : content.formEmailPlaceholder}
        class:list={["form-input", fieldErrors.email && "error"]}
        aria-invalid={fieldErrors.email ? "true" : undefined}
        aria-describedby={fieldErrors.email ? "f-email-error" : undefined}
      />
      {fieldErrors.email && (
        <p id="f-email-error" class="field-error">{fieldErrors.email[0]}</p>
      )}
    </div>
  )}

  <!-- Wilaya + Commune — paired only from `sm` up. Each opens a searchable list
       whose panel is as wide as its trigger, and half a phone is not enough for
       a wilaya name beside its code and the selected-check: the longer names
       wrapped onto a second line. Name and phone above stay paired on phones
       because their answers are short. -->
  <div class="field-pair">
    <div>
      <Select
        id="f-wilaya"
        name="wilayaId"
        label={content.formWilayaLabel}
        hideLabel={true}
        placeholder={`${content.formWilayaLabel} *`}
        searchPlaceholder={content.searchLabel}
        noResultsText={content.noResultsLabel}
        required={true}
        requiredMessage={content.formRequiredField}
        error={fieldErrors.wilayaId?.[0]}
        options={wilayaOptions}
      />
      {fieldErrors.wilayaId && (
        <p class="field-error">{fieldErrors.wilayaId[0]}</p>
      )}
    </div>

    <div>
      <Select
        id="f-commune"
        name="communeId"
        label={content.formCommuneLabel}
        hideLabel={true}
        placeholder={`${content.formCommuneLabel} *`}
        searchPlaceholder={content.searchLabel}
        noResultsText={content.noResultsLabel}
        required={true}
        requiredMessage={content.formRequiredField}
        error={fieldErrors.communeId?.[0]}
        options={[]}
        dynamic={true}
      />
      {fieldErrors.communeId && (
        <p class="field-error">{fieldErrors.communeId[0]}</p>
      )}
    </div>
  </div>

  <!-- Delivery type — the one group that keeps a visible label, because the two
       options are a choice the shopper has to notice, not a field to fill. -->
  <div>
    <fieldset>
      <legend class="form-label">{content.formDeliveryLabel}</legend>
      <div class:list={["delivery-choices", singleDelivery && "is-single"]} id="delivery-type-group">
        {deliveryChoices.map(({ value, icon, label }, i) => (
          <label class="delivery-radio-label">
            <input
              type="radio" name="deliveryType" value={value}
              checked={i === 0} class="sr-only delivery-radio-input"
            />
            <span class:list={["delivery-face choice", i === 0 && "is-on"]}>
              <Icon name={icon} aria-hidden="true" /><span>{label}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>

  <!-- Address - CONDITIONAL: Only shown for home delivery, and only when not hidden by policy.
       When hidden, merchants take the address by phone after the order lands. -->
  {showAddress && (
    <div id="address-field-container" class="field">
      <label for="f-address" class="sr-only">{content.formAddressLabel}</label>
      <Icon name="heroicons:map-pin" class="field-icon" aria-hidden="true" />
      <input
        id="f-address" type="text" name="address"
        autocomplete="street-address"
        required={addressRequired || undefined}
        data-address-required={addressRequired ? "true" : undefined}
        placeholder={addressRequired
          ? `${content.formAddressLabel} *`
          : content.formAddressPlaceholder}
        class:list={["form-input", fieldErrors.address && "error"]}
      />
      {fieldErrors.address && (
        <p class="field-error">{fieldErrors.address[0]}</p>
      )}
    </div>
  )}

  {showNotes && (
    <div>
      <label for="f-notes" class="sr-only">{content.formNotesLabel}</label>
      <textarea
        id="f-notes" name="notes" rows="2"
        placeholder={content.formNotesPlaceholder}
        class="form-input"
      ></textarea>
    </div>
  )}

  {/* The merchant's own questions, in the order they arranged them. Answers are
      gathered into one hidden JSON input at submit — see checkout.ts/product.ts. */}
  {policy.customFields.map((field) => (
    <CustomFieldRow field={field} content={content} />
  ))}
  {policy.customFields.length > 0 && (
    <input type="hidden" name="customFieldResponses" id="custom-field-responses-input" value="[]" />
  )}
</div>

<style>
  /* Two fields share a line only where the form is wide enough for each placeholder to show whole. */
  .fields { display: flex; flex-direction: column; gap: 0.75rem; container-type: inline-size; }
  .field-pair { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  @container (min-width: 32rem) { .field-pair { grid-template-columns: 1fr 1fr; } }
  .field { position: relative; }
  .field :global(.field-icon) {
    position: absolute;
    top: 1.625rem;
    inset-inline-start: 0.875rem;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--clr-muted);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .field :global(.form-input) { padding-inline-start: 2.5rem; }
  .field-error { margin-top: 0.375rem; padding-inline-start: 0.25rem; color: var(--clr-error); font-size: var(--text-xs); font-weight: 600; }
  .delivery-choices { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .delivery-choices.is-single { grid-template-columns: 1fr; }
  .delivery-radio-label { cursor: pointer; }
  .is-single .delivery-radio-label { cursor: default; }
  .delivery-face {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    user-select: none;
  }
  .delivery-face :global(svg) { width: 1.25rem; height: 1.25rem; flex: none; }
  .delivery-face.is-on { border-color: var(--clr-ink); box-shadow: inset 0 0 0 1px var(--clr-ink); }
  .delivery-radio-input:focus-visible + .delivery-face { outline: 2px solid var(--clr-ink); outline-offset: 2px; }
</style>
