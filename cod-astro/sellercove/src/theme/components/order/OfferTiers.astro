---
import { Image } from "astro:assets";
import { getOfferTierView, getProductView, getQuantityTierViews, optionStates, productImageSource, type Offer, type OptionSelection, type ProductDetail } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import { formatAmount, formatCurrency } from "@/theme/utils/money";
import { safeHex } from "@/theme/utils/brand";
import { message } from "@/theme/content/messages";
import { Icon } from "astro-icon/components";

interface Props {
  product: ProductDetail;
  offers: Offer[];
  basePrice: number;
  comparePrice: number | null;
  cur: string;
  isRTL: boolean;
  content: StoreFrontContent;
  defaultVariantId: string | null;
}

const { product, offers, basePrice, comparePrice, cur, content, defaultVariantId } = Astro.props;
const locale = Astro.locals.store.locale;
const hasVariants = product.hasVariants && product.variantOptions && product.variantOptions.length > 0;
const photo = productImageSource(product);

// The buttons open on the SDK's default variant — one that exists and can be
// sold — and a tier locked to a variant shows only that variant's values.
const selection: OptionSelection = getProductView(product).defaultVariant?.variations ?? {};
const states = optionStates(product, selection);

// Each tier is priced once here; the best-value tile is the one that saves the
// shopper the most money, so the badge is earned by the numbers, never claimed.
const tiers = offers.map((offer) => ({ offer, view: getOfferTierView(offer, basePrice, comparePrice) }));
// Quantity pricing's tiers, as the tiles that choose the quantity — one piece at
// the catalog price first when no tier starts there. What the chosen quantity
// costs is the server's cart quote, never computed here.
const pricedTiers = product.quantityPricing ? getQuantityTierViews(product.quantityPricing, basePrice) : [];
const quantityTiers =
  pricedTiers.length === 0 || pricedTiers.some((tier) => tier.quantity === 1)
    ? pricedTiers
    : [{ quantity: 1, price: basePrice, perUnit: basePrice, savingsAmount: 0, savePct: 0, freeShipping: false }, ...pricedTiers];
const bestId = tiers.reduce<{ id: string | null; saved: number }>(
  (best, { offer, view }) =>
    !view.isFreeShipping && view.savingsAmount > best.saved ? { id: offer.id, saved: view.savingsAmount } : best,
  { id: null, saved: 0 },
).id;
---

{offers.length > 0 ? (
  <div id="offer-tier-section" class="space-y-4">
    <p class="tier-heading">{content.offerSectionTitle}</p>

    <div class="tier-grid">
      <label id="tier-card-base" class="tier-label tier-tile is-selected" data-qty="1" data-offer-id="">
        <input type="radio" name="tierSelect" value="base" class="sr-only" checked />
        <span class="tier-qty">{message(content, "offerQuantity", { count: 1 }, locale)}</span>
        <span class="tier-check" aria-hidden="true"><Icon name="heroicons:check" /></span>
        <span class="tier-photo">
          {photo && <Image src={photo} alt="" width={160} height={160} quality={80} class="tier-img" />}
        </span>
        <span class="tier-name">{content.offerBuyOne}</span>
        <span class="tier-price" id="tier-price-base">{formatAmount(basePrice)}<span class="price-cur">{cur}</span></span>
        {comparePrice != null && <span class="tier-was">{formatCurrency(comparePrice, cur)}</span>}
      </label>

      {tiers.map(({ offer, view }) => {
        const shownByDefault = !offer.triggerVariantId || offer.triggerVariantId === defaultVariantId;
        const rewardCount = offer.rewardQuantity > 1 ? `${offer.rewardQuantity} × ` : "";
        const rewardLabel = rewardCount + offer.rewardProductName + (offer.rewardVariantLabel ? ` — ${offer.rewardVariantLabel}` : "");
        return (
          <label
            id={`tier-card-${offer.id}`}
            class:list={["tier-label tier-tile", !shownByDefault && "hidden", offer.id === bestId && "is-best"]}
            data-qty={offer.triggerQuantity}
            data-offer-id={offer.id}
            data-discount-type={offer.discountType}
          >
            <input type="radio" name="tierSelect" value={offer.id} class="sr-only" />
            <span class="tier-qty">{message(content, "offerQuantity", { count: offer.triggerQuantity }, locale)}</span>
            <span class="tier-check" aria-hidden="true"><Icon name="heroicons:check" /></span>
            {offer.id === bestId && <span class="tier-best">{content.offerBestValue}</span>}
            <span class="tier-photo">
              {photo && <Image src={photo} alt="" width={160} height={160} quality={80} class="tier-img" />}
            </span>
            <span class="tier-name">{offer.name}</span>
            <span class="tier-price" id={`tier-price-${offer.id}`}>{formatAmount(view.price)}<span class="price-cur">{cur}</span></span>
            {view.comparePrice != null && <span class="tier-was">{formatCurrency(view.comparePrice, cur)}</span>}
            {view.isFreeShipping ? (
              <span class="tier-reward">{content.offerFreeShippingBadge}</span>
            ) : (
              <span class="tier-reward">{rewardLabel} · {content.offerFreeLabel}</span>
            )}
            {!view.isFreeShipping && view.savingsAmount > 0 && (
              <span class="tier-save">{message(content, "offerSavingsText", { amount: formatAmount(view.savingsAmount), currency: cur }, locale)}</span>
            )}
          </label>
        );
      })}
    </div>

    <!-- The options for the selected tier, shown once below the tiles. -->
    <div class="tier-panels">
      <div id="tier-variants-base" class="tier-panel">
        {hasVariants && product.variantOptions!.map((opt) => (
          <div class="tier-option">
            <p class="tier-option-label">{opt.name}</p>
            <div class="tier-pills">
              {opt.values.map((val) => (
                <button
                  type="button"
                  class:list={["variant-opt", selection[opt.name] === val.value && "is-selected"]}
                  data-option={opt.name}
                  data-value={val.value}
                  data-state={states[opt.name]?.[val.value]}
                  aria-pressed={selection[opt.name] === val.value ? "true" : "false"}
                >
                  {val.hexColor && (
                    <span class="swatch" style={`background: ${safeHex(val.hexColor, "transparent")}`}></span>
                  )}
                  <span>{val.value}</span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      {tiers.map(({ offer }) => {
        const lockedVariant = offer.triggerVariantId ? product.variants.find((v) => v.id === offer.triggerVariantId) : null;
        const unitSelection: OptionSelection = lockedVariant?.variations ?? selection;
        const unitStates = optionStates(product, unitSelection);
        return (
          <div id={`tier-variants-${offer.id}`} class="tier-panel hidden">
            {hasVariants && Array.from({ length: offer.triggerQuantity }, (_, unitIndex) => (
              <div class:list={["tier-unit", unitIndex > 0 && "is-next"]}>
                <p class="tier-unit-head">
                  <span class="tier-unit-num">{unitIndex + 1}</span>
                  {message(content, "offerUnitLabel", { n: unitIndex + 1 }, locale)}
                </p>
                {product.variantOptions!.map((opt) => {
                  const lockedValue = lockedVariant?.variations[opt.name] ?? null;
                  return (
                    <div class="tier-option">
                      <p class="tier-option-label">{opt.name}</p>
                      <div class="tier-pills">
                        {opt.values.map((val) => {
                          const isActive = unitSelection[opt.name] === val.value;
                          const isHidden = lockedValue !== null && lockedValue !== val.value;
                          return !isHidden ? (
                            <button
                              type="button"
                              class:list={["tier-unit-opt", isActive && "is-selected", lockedValue !== null && "is-locked"]}
                              data-tier-id={offer.id}
                              data-unit={unitIndex}
                              data-option={opt.name}
                              data-value={val.value}
                              data-state={unitStates[opt.name]?.[val.value]}
                              aria-pressed={isActive ? "true" : "false"}
                            >
                              {val.hexColor && (
                                <span class="swatch" style={`background: ${safeHex(val.hexColor, "transparent")}`}></span>
                              )}
                              <span>{val.value}</span>
                            </button>
                          ) : null;
                        })}
                      </div>
                    </div>
                  );
                })}
              </div>
            ))}
          </div>
        );
      })}
    </div>

    <input type="number" name="quantity" id="qty-input" value="1" min="1" max="100" class="sr-only" aria-label={content.ariaQuantity} />
  </div>
) : (
  quantityTiers.length > 0 ? (
    <div class="space-y-3">
      <p class="tier-heading">{content.offerSectionTitle}</p>
      <!-- The tiles are the quantity: each orders its own number of pieces. -->
      <div class="tier-grid" role="radiogroup" aria-label={content.offerSectionTitle}>
        {quantityTiers.map((tier) => (
          <button type="button" class:list={["tier-tile qty-tier", tier.quantity === 1 && "is-selected"]} data-qty={tier.quantity} role="radio" aria-checked={tier.quantity === 1 ? "true" : "false"}>
            <span class="tier-qty">{message(content, "offerQuantity", { count: tier.quantity }, locale)}</span>
            <span class="tier-check" aria-hidden="true"><Icon name="heroicons:check" /></span>
            <span class="tier-price">{formatAmount(tier.price)}<span class="price-cur">{cur}</span></span>
            <span class="tier-name">{message(content, "qtyTierEach", { price: formatCurrency(tier.perUnit, cur) }, locale)}</span>
            {tier.savePct > 0 && <span class="tier-save">{message(content, "qtyTierSave", { pct: tier.savePct }, locale)}</span>}
            {tier.freeShipping && <span class="tier-reward">{content.offerFreeShippingBadge}</span>}
          </button>
        ))}
      </div>
      <input type="number" name="quantity" id="qty-input" value="1" min="1" max="100" class="sr-only" aria-label={content.ariaQuantity} />
    </div>
  ) : (
  <div class="flex items-center justify-between gap-4">
    <!-- No offers: standalone quantity stepper -->
    <div>
      <p class="tier-heading">{content.qtyLabel}</p>
      <p class="tier-sub">{content.qtyUnit}</p>
    </div>
    <div class="qty" dir="ltr">
      <button type="button" id="qty-minus" class="qty-btn">−</button>
      <input type="number" name="quantity" id="qty-input" value="1" min="1" max="100" inputmode="numeric" class="qty-input" aria-label={content.ariaQuantity} />
      <button type="button" id="qty-plus" class="qty-btn">+</button>
    </div>
  </div>
  )
)}
<p id="qty-stock-hint" class="mt-1 hidden text-end text-xs font-semibold text-error" aria-live="polite"></p>

<style>
  .tier-heading { color: var(--clr-ink); font-size: var(--text-sm); font-weight: 600; }
  .tier-sub { margin-top: 0.125rem; color: var(--clr-muted); font-size: var(--text-xs); }
  /* The tiers are cards in a column: a radio, how many pieces the tier sells,
     the offer's name and what it gives, and its price at the end. The best
     value carries a flag. */
  .tier-grid { display: grid; gap: 0.625rem; padding-top: 0.625rem; }
  .tier-tile {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      "check qty price"
      "check name was"
      "check reward was"
      "check save was";
    align-items: center;
    column-gap: 0.875rem;
    row-gap: 0.125rem;
    min-height: 3.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--clr-border-strong);
    border-radius: var(--radius-input);
    background: var(--clr-field);
    color: var(--clr-ink);
    text-align: start;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .tier-tile.hidden { display: none; }
  .tier-tile:hover { border-color: color-mix(in oklab, var(--clr-ink) 45%, var(--clr-border-strong)); }
  .tier-tile.is-selected { border-color: var(--clr-ink); box-shadow: inset 0 0 0 1px var(--clr-ink); }
  .tier-tile:has(input:focus-visible),
  .tier-tile:focus-visible { outline: 2px solid var(--clr-ink); outline-offset: 2px; }
  .tier-photo { display: none; }
  .tier-qty { grid-area: qty; align-self: end; font-size: var(--text-xs); font-weight: 600; color: var(--clr-muted); line-height: 1.4; }
  .tier-check {
    grid-area: check;
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    border: 1.5px solid var(--clr-border-strong);
    border-radius: var(--radius-round);
    background: var(--clr-field);
    transition: border-width 0.15s ease, border-color 0.15s ease;
  }
  .tier-check svg { display: none; }
  .tier-tile.is-selected .tier-check { border: 0.375rem solid var(--clr-ink); }
  .tier-best {
    position: absolute;
    top: -0.6875rem;
    inset-inline-end: 0.875rem;
    z-index: 1;
    min-height: 1.375rem;
    padding-inline: 0.625rem;
    border-radius: var(--radius-tag);
    background: var(--clr-highlight);
    color: var(--clr-on-highlight);
    font-size: var(--text-2xs);
    font-weight: 700;
    white-space: nowrap;
  }
  .tier-name { grid-area: name; overflow: hidden; font-size: var(--text-base); font-weight: 600; line-height: 1.4; text-overflow: ellipsis; }
  .tier-price { grid-area: price; justify-self: end; align-self: end; font-variant-numeric: tabular-nums lining-nums; font-size: var(--text-base); font-weight: 600; color: var(--clr-ink); white-space: nowrap; }
  .tier-was { grid-area: was; justify-self: end; align-self: start; font-size: var(--text-xs); color: var(--clr-muted); text-decoration: line-through; white-space: nowrap; }
  .tier-reward { grid-area: reward; font-size: var(--text-xs); font-weight: 600; color: var(--clr-success); line-height: 1.4; }
  .tier-save { grid-area: save; font-size: var(--text-xs); font-weight: 600; color: var(--clr-success); line-height: 1.4; }
  .qty-tier { cursor: pointer; }
  .qty-tier:disabled { cursor: not-allowed; opacity: 0.45; }

  .tier-panels { display: block; }
  .tier-panel { padding-top: 1rem; }
  .tier-panel.hidden { display: none; }
  .tier-panel:empty { display: none; }
  .tier-option + .tier-option { margin-top: 1rem; }
  .tier-option-label { margin-bottom: 0.625rem; color: var(--clr-muted); font-size: var(--text-sm); }
  .tier-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .variant-opt,
  .tier-unit-opt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid var(--clr-border-strong);
    border-radius: var(--radius-tag);
    background: var(--clr-field);
    color: var(--clr-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .variant-opt:has(.swatch),
  .tier-unit-opt:has(.swatch) { padding-inline-start: 0.375rem; }
  .variant-opt:hover,
  .tier-unit-opt:hover { border-color: var(--clr-ink); }
  .variant-opt.is-selected,
  .tier-unit-opt.is-selected { border-color: var(--clr-ink); box-shadow: inset 0 0 0 1px var(--clr-ink); font-weight: 600; }
  .tier-unit-opt.is-locked { pointer-events: none; }
  .variant-opt:focus-visible,
  .tier-unit-opt:focus-visible { outline: 2px solid var(--clr-ink); outline-offset: 2px; }
  .variant-opt[data-state="sold_out"],
  .tier-unit-opt[data-state="sold_out"] { color: var(--clr-muted); text-decoration: line-through; }
  .variant-opt[data-state="unavailable"],
  .tier-unit-opt[data-state="unavailable"] { color: var(--clr-muted); border-style: dashed; }
  .swatch {
    width: 1.875rem;
    height: 1.875rem;
    border-radius: var(--radius-round);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, black 12%, transparent);
    flex: none;
  }
  .tier-unit + .tier-unit { margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--clr-border-strong); }
  .tier-unit-head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; font-size: var(--text-sm); font-weight: 600; color: var(--clr-ink); }
  .tier-unit-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-round);
    background: var(--clr-ink);
    color: var(--clr-bg);
    font-size: var(--text-xs);
  }

  .qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--clr-border-strong);
    border-radius: var(--radius-tag);
    background: var(--clr-field);
    overflow: hidden;
    flex: none;
  }
  .qty-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: var(--clr-clear);
    color: var(--clr-ink);
    font-size: var(--text-lg);
    font-weight: 500;
    cursor: pointer;
  }
  .qty-btn:hover { background: var(--clr-plate); }
  .qty-input {
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: var(--clr-clear);
    text-align: center;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--clr-ink);
    appearance: textfield;
  }
  .qty-input:focus { outline: none; }
</style>
