---
import { actions } from "astro:actions";
import type {
  CheckoutFormPolicy,
  Offer,
  ProductDetail,
  ProductVariant,
} from "@wocart/storefront";
import { getProductView, type CouponRefusal } from "@wocart/storefront";
import type { StoreFrontContent } from "@/theme/content";
import type { FieldErrors } from "@/theme/types";
import { Icon } from "astro-icon/components";
import { schemeClass } from "@wocart/theme";

import VariantSelector from "./VariantSelector.astro";
import OfferTiers from "./OfferTiers.astro";
import CustomerFields from "./CustomerFields.astro";
import OrderSummary from "./OrderSummary.astro";
import CouponField from "./CouponField.astro";
import OtpStep from "./OtpStep.astro";
import TurnstileField from "./TurnstileField.astro";

interface Props {
  product: ProductDetail;
  content: StoreFrontContent;
  fieldErrors: FieldErrors;
  /** Why the last post was refused, in the store's words. */
  notice: string | null;
  /** The order was refused for its code: the code box says why. */
  couponRefusal?: CouponRefusal | null;
  basePrice: number;
  defaultVariant: ProductVariant | null;
  cur: string;
  isRTL: boolean;
  offers: Offer[];
  defaultVariantId: string | null;
  isOutOfStock?: boolean;
  otpEnabled?: boolean;
  turnstileEnabled?: boolean;
  turnstileSiteKey?: string | null;
  /** Landing page attribution — rides the form like fbc/fbp (best-effort). */
  landingPageSlug?: string | null;
  /**
   * The merchant's order-form configuration (config.checkoutForm). Passed
   * straight through to CustomerFields, which defaults it to today's form when
   * the server is older than the feature.
   */
  formPolicy?: CheckoutFormPolicy;
  /** Which order action comes first: the confirm button, or Add to cart (the `secondary-action` slot). */
  buttonOrder?: "order-first" | "cart-first";
  /** The three assurances under the buttons. */
  showAssurance?: boolean;
  /** The color scheme the panel wears; absent, a tint of the page's. */
  scheme?: string | undefined;
}

const { product, content, fieldErrors, notice, couponRefusal = null, basePrice, defaultVariant, cur, isRTL, offers, defaultVariantId, isOutOfStock = false, otpEnabled = false, turnstileEnabled = false, turnstileSiteKey = null, landingPageSlug = null, formPolicy, buttonOrder = "order-first", showAssurance = true, scheme } = Astro.props;

const comparePrice = getProductView(product).comparePrice;
---

<!-- The order form: the product's options and offers, then the checkout panel. -->
<div class="order" id="order-section">
  <form method="POST" action={actions.placeOrder} class="order-form" data-checkout data-astro-reload>
    <!-- Hidden product fields -->
    <input type="hidden" name="productId"          value={product.id} />
    <!-- Meta Pixel tracking (populated by JS at submit time) -->
    <input type="hidden" name="fbc" id="fbc-input" value="" />
    <input type="hidden" name="fbp" id="fbp-input" value="" />
    <input type="hidden" name="productName"        value={product.name} />
    <input type="hidden" name="pricePerUnit"       value={basePrice} id="price-input" />
    <input type="hidden" name="variantId"          value={defaultVariant?.id ?? ""} id="variant-id-input" />
    <input type="hidden" name="variantLabel"       value="" id="variant-label-input" />
    <input type="hidden" name="offerId"            value="" id="offer-id-input" />
    <input type="hidden" name="variantSelections"  value="[]" id="variant-selections-input" />
    {/* No `items` field here on purpose. This form orders the ONE product it
        was rendered for; a basket checks out on /checkout, where the summary
        the shopper is reading matches what gets submitted. */}
    {/* WhatsApp OTP proof — set by the OTP step script after verification */}
    <input type="hidden" name="otpToken" id="otp-token-input" value="" />
    {/* Landing page attribution — present only on landing pages */}
    {landingPageSlug && <input type="hidden" name="landingPageSlug" value={landingPageSlug} />}

    <div class="order-choices">
      {/* Standalone variant selector only when no offers — otherwise it lives inside the tier cards */}
      {offers.length === 0 && <VariantSelector product={product} />}

      <OfferTiers
        product={product}
        offers={offers}
        basePrice={basePrice}
        comparePrice={comparePrice}
        cur={cur}
        isRTL={isRTL}
        content={content}
        defaultVariantId={defaultVariantId}
      />
    </div>

    <div class:list={["waybill", schemeClass(scheme)]}>
      <div class="waybill-head">
        <h2 class="order-title">{content.formTitle}</h2>
        <span class="cod-chip"><Icon name="heroicons:banknotes" aria-hidden="true" />{content.orderCtaSubtext}</span>
      </div>

      {notice && (
        <div class="order-error" role="alert">
          <Icon name="heroicons:exclamation-triangle" aria-hidden="true" />
          <p>{notice}</p>
        </div>
      )}

      <CustomerFields
        content={content}
        fieldErrors={fieldErrors}
        isRTL={isRTL}
        formPolicy={formPolicy}
      />

      {otpEnabled && <OtpStep content={content} isRTL={isRTL} />}

      {turnstileEnabled && turnstileSiteKey && (
        <TurnstileField siteKey={turnstileSiteKey} content={content} />
      )}

      <CouponField content={content} cur={cur} couponRefusal={couponRefusal} />

      <OrderSummary
        product={product}
        basePrice={basePrice}
        cur={cur}
        offers={offers}
        content={content}
      />

      {/* The two order actions read as one decision: the confirm button and,
          when the store sells by basket, Add to cart — in the order the
          merchant chose. */}
      <div class:list={["order-actions", buttonOrder === "cart-first" && "is-cart-first"]}>
        <button
          type="submit"
          class="btn-primary btn-lg order-submit"
          id="submit-btn"
          disabled={isOutOfStock || undefined}
        >
          {isOutOfStock ? content.outOfStock : content.formSubmit}
        </button>
        <div class="order-secondary empty:hidden">
          <slot name="secondary-action" />
        </div>
      </div>

      {showAssurance && (
        <ul class="assure">
          <li><Icon name="heroicons:shield-check" aria-hidden="true" />{content.productAssureNoPrepay}</li>
          <li><Icon name="heroicons:phone" aria-hidden="true" />{content.productAssureCall}</li>
          <li><Icon name="heroicons:truck" aria-hidden="true" />{content.productAssureDelivery}</li>
        </ul>
      )}

      <p class="order-note">{content.formConfirmNote}</p>
    </div>
  </form>
</div>

<style>
  .order { scroll-margin-top: calc(var(--header-h) + 1rem); }
  .order-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .order-choices { display: flex; flex-direction: column; gap: 1.25rem; }
  .order-choices:empty { display: none; }
  .waybill { display: flex; flex-direction: column; gap: 1rem; padding: 1.25rem 1rem; }
  .waybill:not(.wc-scheme) { background: var(--clr-plate); }
  @media (min-width: 640px) { .waybill { padding: 1.75rem; } }
  .order-title { font-size: var(--text-xl); font-weight: 600; }
  .cod-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 1.875rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-tag);
    background: var(--clr-field);
    color: var(--clr-ink);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .cod-chip :global(svg) { width: 1rem; height: 1rem; color: var(--clr-success); }
  .order-error {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-input);
    background: var(--clr-error-bg);
    color: var(--clr-error);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .order-error :global(svg) { width: 1.25rem; height: 1.25rem; flex: none; }
  .order-actions { display: flex; flex-direction: column; gap: 0.625rem; margin-top: 0.25rem; }
  .order-submit { box-shadow: var(--shadow-primary); }
  .order-submit:disabled { box-shadow: none; }
  .is-cart-first .order-secondary { order: -1; }
  .is-cart-first .order-submit { background: transparent; color: var(--clr-ink); border-color: var(--clr-ink); box-shadow: none; }
  .is-cart-first .order-secondary :global([data-add-to-cart]) { background: var(--clr-primary); color: var(--clr-on-primary); border-color: var(--clr-primary); }
  .assure {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    padding-top: 0.25rem;
  }
  .assure li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    color: var(--clr-ink);
    font-size: var(--text-xs);
    line-height: 1.4;
    text-align: center;
  }
  .assure :global(svg) { width: 1.375rem; height: 1.375rem; }
  .order-note { color: var(--clr-text); font-size: var(--text-sm); text-align: center; }
</style>

<script src="../../scripts/checkout-key.ts"></script>
