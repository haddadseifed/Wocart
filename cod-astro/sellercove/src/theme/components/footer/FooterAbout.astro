---
// The store's name (or logo), a few words about it, a way to reach it on
// WhatsApp when the store's contact widget is on, and its social pages, each
// opening in a new tab.
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { canonicalUrl } from "@wocart/storefront";
import type { InferProps } from "@wocart/theme";
import type { footerAbout } from "@/theme/catalog/footer/footer.def";
import SocialIcon from "@/theme/components/ui/SocialIcon.astro";
import { storeWhatsApp } from "@/theme/utils/whatsapp";

type Props = InferProps<typeof footerAbout>;
const { text, showWhatsapp, socialLinks = [] } = Astro.props;
const store = Astro.locals.store;
const { config, content } = store;
const whatsapp = showWhatsapp ? storeWhatsApp(store, { kind: "general", url: canonicalUrl(Astro.url.origin, store, Astro.url.search) }, { cta: content.footerWhatsapp }) : null;
const networkName = { instagram: content.socialInstagram, facebook: content.socialFacebook, tiktok: content.socialTiktok, youtube: content.socialYoutube };
const social = socialLinks.filter((link) => link.href);
---

<div class="footer-col footer-about">
  <a href={Astro.locals.store.href("/")} class="footer-brand" aria-label={config.name}>
    {config.logo ? (
      <Image src={config.logo.url} alt={config.name} width={320} height={96} fit="scale-down" quality={90} loading="lazy" decoding="async" />
    ) : (
      <span>{config.name}</span>
    )}
  </a>
  {text && <p class="footer-about-text">{text}</p>}
  {whatsapp && (
    <a href={whatsapp.href} class="footer-whatsapp" rel="noopener noreferrer" target="_blank">
      <Icon name="heroicons:chat-bubble-left-right" aria-hidden="true" />
      {whatsapp.ctaLabel}
    </a>
  )}
  {social.length > 0 && (
    <ul class="footer-social">
      {social.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label || networkName[link.network]}>
            <SocialIcon network={link.network} />
          </a>
        </li>
      ))}
    </ul>
  )}
</div>
