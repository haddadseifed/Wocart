# CodFlow storefront (cod-astro/theme-00) — local development secrets
# Copy this file to .dev.vars and fill in your values.
# (.dev.vars is gitignored — your real values never get committed.)

# API key for the store — must match the key_hash seeded into D1
# (see cod-server/scripts/seed-store.ts; the local seed uses "codflow-dev-store-key"
# when STORE_API_KEY is not set).
STORE_API_KEY=codflow-dev-store-key

# Base URL of the cod-server API Worker.
COD_SERVER_URL=http://localhost:8787

# Optional: the editor's preview public key — an Ed25519 JWK, one line, e.g.
# {"kty":"OKP","crv":"Ed25519","x":"…"}. Unset → /wocart-preview answers 404.
# WOCART_PREVIEW_KEY=
