{
  "name": "sellercove-storefront",
  "private": true,
  "type": "module",
  "version": "5.6.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:vercel": "DEPLOY_TARGET=vercel astro build",
    "build:cf": "DEPLOY_TARGET=cloudflare astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "key:create": "astro create-key",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv src/env.d.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "validate:strings": "node scripts/validate-strings.js",
    "validate:styles": "node scripts/validate-styles.js",
    "validate:all": "node scripts/validate-all.js",
    "validate": "npm run validate:all && npm run build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/vercel": "^11.0.10",
    "@iconify-json/heroicons": "^1.2.3",
    "@wocart/storefront": "4.3.0",
    "@wocart/theme": "4.3.0",
    "astro": "^7.3.2",
    "astro-icon": "^1.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/ui": "^5.1.0",
    "fast-check": "^4.6.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "overrides": {
    "vite": "^8.2.2",
    "@cloudflare/vite-plugin": "1.53.1"
  }
}
