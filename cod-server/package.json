{
  "name": "codflow-server",
  "version": "1.1.0",
  "description": "COD Flow Backend Worker - Cloudflare Workers API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to ../.wrangler-shared",
    "deploy": "node -e \"console.error('Deployment is disabled. Use npm run deploy:production to deploy explicitly.'); process.exit(1)\"",
    "build:ci": "wrangler deploy --env production --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/d1.mjs migrations apply --local --persist-to ../.wrangler-shared",
    "db:migrate:remote": "node scripts/d1.mjs migrations apply --remote",
    "db:seed:local": "npx tsx scripts/seed-store.ts",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:seed:remote": "npx tsx scripts/seed-store.ts --remote",
    "db:setup:remote": "npm run db:migrate:remote && npm run db:seed:remote",
    "r2:lifecycle": "node scripts/setup-r2-lifecycle.mjs",
    "events:release-catalogue": "npx tsx scripts/release-event-catalogue.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:property": "vitest --run tests/property",
    "test:performance": "vitest --run tests/performance",
    "test:ci": "vitest --run --coverage --reporter=json --reporter=html",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.20",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@noble/hashes": "^2.3.0",
    "agents": "^0.33.0",
    "ai": "^7.0.70",
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@hono/zod-openapi": "^1.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "@wocart/storefront": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.9.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.125.0"
  }
}
